# development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Use the deterministic authentication and dashboard services while Laravel APIs are pending.
NEXT_PUBLIC_USE_MOCK_API=true

# Enable only for local development against a remote Sanctum backend. The browser
# uses a same-origin route while Next.js forwards the request and rewrites cookies.
NEXT_PUBLIC_USE_LOCAL_API_PROXY=false
LARAVEL_UPSTREAM_URL=https://mosaiq.axtrics.com
LARAVEL_STATEFUL_ORIGIN=http://localhost:3000

# API base and Laravel application origin. Both are build-time public configuration.
# Local real-API example:
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_LARAVEL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=https://mosaiq.axtrics.com/api/v1
NEXT_PUBLIC_LARAVEL_URL=https://mosaiq.axtrics.com
